    <string name="onboarding_1_title">Scams hide in ordinary messages</string>
    <string name="onboarding_1_body">Wedding invitations, courier photos, fake officials. Many arrive as APK files, not links.</string>
    <string name="onboarding_2_title">Sigap watches quietly</string>
    <string name="onboarding_2_body">No copy and paste. Sigap only warns you when a message looks risky.</string>
    <string name="onboarding_3_title">Your messages stay yours</string>
    <string name="onboarding_3_body">Analysis runs on your device. Text is redacted before any cloud check, and you stay in control.</string>

